# Required: your Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Local MongoDB by default. Swap in your Atlas URI to use Atlas instead.
MONGODB_URI=mongodb://127.0.0.1:27017/codebase-explainer

# Optional but recommended: a GitHub personal access token (no scopes needed for public repos).
# Without it GitHub allows 60 API requests/hour per IP; each analysis uses ~3.
GITHUB_TOKEN=

# Optional: "Sign in with GitHub" (private repos + "My analyses"). All three are needed to turn it on.
# Create an OAuth App at https://github.com/settings/developers with this callback URL:
#   http://localhost:5173/api/auth/github/callback   (the client origin; Vite proxies /api to this server)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Also derives the key that encrypts stored GitHub tokens: changing it signs everyone out of private-repo access.
SESSION_SECRET=
# Only if the callback isn't ${CLIENT_ORIGIN}/api/auth/github/callback
# GITHUB_CALLBACK_URL=

PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Analyses (cache misses) allowed per IP per hour
ANALYZE_LIMIT_PER_HOUR=5
